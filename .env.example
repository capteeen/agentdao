# ---- client
NEXT_PUBLIC_BOSS_BACKEND=live          # sim | live  (sim = in-browser mock, no server needed)
NEXT_PUBLIC_SOLANA_RPC=https://api.mainnet-beta.solana.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- server (API routes + worker)
BOSS_MODE=paper                        # paper | live. paper: real governance + market data, simulated fills
BOSS_MARKET=pumpportal                 # pumpportal | synthetic (offline tape for dev/CI)
BOSS_DB=./data/boss.sqlite
SOLANA_RPC=https://api.mainnet-beta.solana.com
# 32 bytes hex. Required in live mode (encrypts agent secret keys at rest). `openssl rand -hex 32`
BOSS_KEY_ENCRYPTION_KEY=
# Claude API for one-line trade explanations (optional; template fallback otherwise). BOSS_EXPLAIN=0 disables.
ANTHROPIC_API_KEY=
BOSS_EXPLAIN_MODEL=claude-opus-5-5

# ---- governance / cadence (ms)
BOSS_VOTE_MS=3600000                   # 1h votes
BOSS_QUORUM=0.05
BOSS_PROPOSAL_FEE=0.01
BOSS_TICK_MS=2000
BOSS_EVAL_MS=20000
BOSS_REPORT_MS=86400000
BOSS_FEE_CLAIM_MS=21600000
